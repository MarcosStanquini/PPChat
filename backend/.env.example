# AWS Configuration
# Your AWS credentials should be configured via AWS CLI, IAM role, or environment variables
# AWS_ACCESS_KEY_ID=your_access_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=us-east-1

# AWS Bedrock Model Configuration
# Use cross-region inference profile instead of direct model ID
BEDROCK_MODEL_ID=us.anthropic.claude-3-5-sonnet-20241022-v2:0

# LLM Configuration
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=600

# Vector Store Configuration
VECTOR_STORE_PATH=api/rag/vector_store/db/chroma
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# RAG Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# File Processing
FILE_PATH=api/rag/data/documents/PPCENGSOFTWARE.pdf
